+      <div className="bs-cine-bars bottom" />
+      <div className="bs-cine-top bs-ghost">
+        <span className={`bs-tag ${beat.tag}`}>{beat.tag === 'real' ? 'TRUE STORY · NASA HISTORY' : 'FICTION · YOUR STORY'}</span>
+      </div>
