+const ringColliders: Collider[] = Array.from({ length: 32 }).map((_, i) => {
+  const a = (i / 32) * Math.PI * 2;
+  return { x: Math.sin(a) * (R + 1.2), z: Math.cos(a) * (R + 1.2), r: 2.2 };
+});
